PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=electric_bus_tracker
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace_this_with_a_long_secret
JWT_EXPIRE=7d
DISABLE_REPORT_SCHEDULER=true
# ses is the default provider for AWS deployments.
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
EMAIL_FROM=

# Optional legacy provider. Set EMAIL_PROVIDER=sendgrid to use this.
SENDGRID_API_KEY=
